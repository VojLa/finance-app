DATABASE_URL="postgresql://postgres:postgres@localhost:5433/finance_app"

NEXTAUTH_SECRET="change-this-secret"
NEXTAUTH_URL="http://localhost:3000"

PYTHON_BACKEND_URL="http://localhost:8010"
INTERNAL_AUTH_SECRET="development-internal-auth-secret-change-me"
INTERNAL_AUTH_ISSUER="finance-app-next"
INTERNAL_AUTH_AUDIENCE="finance-app-python"
INTERNAL_AUTH_TOKEN_TTL_SECONDS="60"
PYTHON_API_TIMEOUT_MS="30000"
NEXT_BACKEND_URL="http://localhost:3010"

# Durable import worker. Keep disabled in tests; Docker development enables one API worker.
BACKGROUND_JOBS_ENABLED="false"
BACKGROUND_JOB_POLL_SECONDS="0.75"
BACKGROUND_JOB_LEASE_SECONDS="300"
BACKGROUND_JOB_HEARTBEAT_SECONDS="15"
BACKGROUND_JOB_SHUTDOWN_GRACE_SECONDS="5"

# COINGECKO_DEMO_API_KEY="replace-with-a-demo-key-when-used"
# TWELVE_DATA_API_KEY="replace-with-a-server-side-api-key"
